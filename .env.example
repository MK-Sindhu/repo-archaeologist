# Repo Archaeologist settings. Copy to .env and fill in; .env is git-ignored.
# Variables already set in your shell take precedence over this file.

# An LLM key is needed for `arch ask` / `mine` / `eval`. Set one (Claude is used if both are set):
# Anthropic (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_GEMINI_KEY=
# Optional: GitHub token for PR/issue lookups (60 -> 5,000 requests/hour). `gh auth login` also works.
GITHUB_TOKEN=

# Optional: force a backend (anthropic | gemini) and/or pick models
# ARCH_PROVIDER=gemini
# Cheaper Claude (Haiku 5.5 is ~40x cheaper than the Opus 5.5 default):
# ARCH_MODEL=claude-haiku-5-5
# ARCH_GRADER_MODEL=claude-haiku-5-5
